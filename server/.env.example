# Copy to .env and fill in. DATABASE_URL comes from the Railway MySQL plugin.
DATABASE_URL=mysql://user:password@host:port/database
JWT_SECRET=
SUPER_ADMIN_EMAIL=hoa.tranbinh@gameloft.com
PORT=3000
NODE_ENV=development

# Email (production): when both are set, OTP/notification mail sends via Resend;
# otherwise the OTP is logged to the server console (dev).
RESEND_API_KEY=
EMAIL_FROM=

# Optional: lock CORS to the deployed frontend origin (omit for same-origin / dev).
CORS_ORIGIN=
